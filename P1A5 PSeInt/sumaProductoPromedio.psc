Algoritmo sumaProductoPromedio
	Definir num1, num2, num3 Como Entero
	Definir suma, prod, prom Como Real
	
	Escribir "Ingrese 3 números:"
	Leer num1, num2, num3
	
	suma = num1 + num2 + num3
	prod = num1 * num2 * num3
	prom = suma/3
	
	Escribir "Suma: ", suma, ", Producto: ", prod, ", Promedio: ", prom
FinAlgoritmo
